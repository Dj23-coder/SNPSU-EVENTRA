rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/clubs/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/clubs/$(request.auth.uid)).data.admin == true)
      );
    }

    function isClubActive(clubUid) {
      return exists(/databases/$(database)/documents/clubs/$(clubUid)) &&
             get(/databases/$(database)/documents/clubs/$(clubUid)).data.active == true;
    }

    function isEventOwner(eventData) {
      return isSignedIn() && (eventData.clubId == request.auth.uid || eventData.ownerId == request.auth.uid);
    }

    function isValidEvent(data) {
      return data.title is string && data.title.size() <= 150 &&
             data.clubId is string && data.clubId.size() <= 100 &&
             data.clubName is string && data.clubName.size() <= 100 &&
             data.shortDescription is string && data.shortDescription.size() <= 200 &&
             data.venue is string && data.venue.size() <= 120 &&
             data.contactName is string && data.contactName.size() <= 100 &&
             data.contactWhatsApp is string && data.contactWhatsApp.size() <= 15;
    }

    // EVENTS COLLECTION:
    // Anyone can read active events. Hidden events are readable ONLY by admin or owner.
    match /events/{eventId} {
      allow get: if isValidId(eventId) && (
        resource.data.hidden != true ||
        isAdmin() ||
        isEventOwner(resource.data)
      );

      allow list: if resource.data.hidden != true || isAdmin();

      // Only signed-in ACTIVE clubs can create events (where ownerId or clubId equals auth.uid)
      allow create: if isSignedIn() &&
                    isValidId(eventId) &&
                    isValidEvent(incoming()) &&
                    (
                      ((incoming().clubId == request.auth.uid || incoming().ownerId == request.auth.uid) && isClubActive(request.auth.uid)) ||
                      isAdmin()
                    ) &&
                    (!('hidden' in incoming()) || incoming().hidden == false || isAdmin());

      // Only owner active club or admin can update; only admins can modify 'hidden' flag
      allow update: if isSignedIn() &&
                    isValidId(eventId) &&
                    isValidEvent(incoming()) &&
                    (
                      (isEventOwner(existing()) && isClubActive(request.auth.uid) && !incoming().diff(existing()).affectedKeys().hasAny(['hidden'])) ||
                      isAdmin()
                    );

      // Only owner active club or admin can delete
      allow delete: if isSignedIn() && isValidId(eventId) && (
        (isEventOwner(existing()) && isClubActive(request.auth.uid)) ||
        isAdmin()
      );

      // Public engagement counters increment
      allow update: if isValidId(eventId) &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['interestedCount', 'viewsCount', 'calendarClicksCount', 'seatsBooked']);
    }

    // CLUBS COLLECTION:
    // Only the admin can create or update club records and the verified and active flags.
    // A club can read only its own record.
    // Students can read only the public fields needed for the Verified badge (club metadata if active).
    match /clubs/{clubId} {
      // Club reads only its own record; admin reads all; students can read active club public metadata
      allow get: if isValidId(clubId) && (
        isAdmin() ||
        (isSignedIn() && request.auth.uid == clubId) ||
        (resource.data.active == true)
      );

      // Only admin can list all clubs
      allow list: if isAdmin();

      // Only admin can create, update, or delete club records (including verified and active flags)
      allow create, update, delete: if isAdmin() && isValidId(clubId);
    }

    // REPORTS COLLECTION:
    // Students can submit event reports without logging in.
    // Only Admins can read, list, and resolve reports.
    match /reports/{reportId} {
      allow create: if isValidId(reportId) &&
                    incoming().keys().hasAll(['eventId', 'eventTitle', 'reason', 'reportedAt']) &&
                    incoming().reason in ['Fake or misleading', 'Inappropriate', 'Wrong details', 'Other'];
      allow read, list, update, delete: if isAdmin() && isValidId(reportId);
    }

    // REGISTRATIONS COLLECTION (In-App Student Participation):
    // Anyone can create a registration that passes validation.
    // Only the event's owner club and the admin can read/list them.
    // No one can edit registrations from the client.
    match /registrations/{registrationId} {
      allow create: if isValidId(registrationId) &&
                    incoming().keys().hasAll(['eventId', 'eventTitle', 'fullName', 'usn', 'email', 'phone', 'registeredAt']) &&
                    incoming().fullName is string && incoming().fullName.size() <= 100 &&
                    incoming().email is string && incoming().email.size() <= 120 &&
                    incoming().usn is string && incoming().usn.size() <= 30;

      // Only the event owner club or admin can read participant data
      allow read: if isAdmin() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/events/$(resource.data.eventId)) &&
        get(/databases/$(database)/documents/events/$(resource.data.eventId)).data.clubId == request.auth.uid
      );

      allow update: if false; // Immutable registrations
      allow delete: if isAdmin();
    }
  }
}
